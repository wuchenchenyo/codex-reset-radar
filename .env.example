NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Official X API bearer token
X_BEARER_TOKEN=

# Preferred: xAI / Grok. AI_API_KEY is an alias, and also accepts MiniMax Token Plan keys (sk-cp-...).
XAI_API_KEY=
AI_API_KEY=
AI_PROVIDER=xai
AI_MODEL=grok-4.6
# MiniMax Token Plan example:
# AI_PROVIDER=minimax
# AI_API_KEY=sk-cp-...
# AI_MODEL=MiniMax-M3
# AI_BASE_URL=https://api.minimax.io/v1
# China accounts: AI_BASE_URL=https://api.minimaxi.com/v1

# Required for cron and manual ingest
CRON_SECRET=

# Optional. Default display timezone.
DEFAULT_TIMEZONE=Asia/Shanghai

# Production is blocked unless this is true
ALLOW_MANUAL_INGEST=false
